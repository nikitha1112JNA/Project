session_start();

// Database connection
$servername = "localhost";
$username = "root"; // Change as per your DB credentials
$password = "";
$dbname = "blood_donation_db";

$conn = new mysqli($servername, $username, $password, $dbname);

// Check for connection error
if ($conn->connect_error) {
    die("Database connection failed: " . $conn->connect_error);
}

if ($_SERVER['REQUEST_METHOD'] == 'POST') {
    // Get user input
    $name = trim($_POST['name']);
    $age = (int)$_POST['age'];
    $phone = trim($_POST['phone']);
    $email = trim($_POST['email']);
    $blood_group = trim($_POST['blood_group']);
    $address = trim($_POST['address']);
    $availability = trim($_POST['availability']);

    // Validate fields
    if (empty($name) || empty($age) || empty($phone) || empty($email) || empty($blood_group) || empty($address) || empty($availability)) {
        echo "<script>alert('All fields are required!');</script>";
    } else {
        // Insert into database using prepared statement
        $stmt = $conn->prepare("INSERT INTO donors (name, age, phone, email, blood_group, address, availability) VALUES (?, ?, ?, ?, ?, ?, ?)");
        $stmt->bind_param("sisssss", $name, $age, $phone, $email, $blood_group, $address, $availability);

        if ($stmt->execute()) {
            // Store data in session to display on confirmation page
            $_SESSION['donor_data'] = [
                'name' => $name,
                'age' => $age,
                'phone' => $phone,
                'email' => $email,
                'blood_group' => $blood_group,
                'address' => $address,
                'availability' => $availability
            ];

            // Redirect to confirmation page
            header("Location: donation_confirmation.php");
            exit();
        } else {
            echo "<script>alert('Error: " . $stmt->error . "');</script>";
        }

        // Close statement
        $stmt->close();
    }
}

// Close connection
$conn->close();
?>

